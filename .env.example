# Supabase — ambil dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dipakai hanya di server, untuk skrip seed dan uji RLS. Jangan pernah dipakai di klien.
SUPABASE_SERVICE_ROLE_KEY=

# LLM — hanya dipakai di server route
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_TEXT=gpt-4o-mini
LLM_MODEL_VISION=gpt-4o-mini

# Mode demo aman: bila "true", ringkasan memakai fallback deterministik
# tanpa memanggil LLM. Dipakai saat demo agar tidak bergantung kuota API.
DEMO_SAFE_MODE=false
